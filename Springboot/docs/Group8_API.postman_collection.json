							"mode": "raw",
							"raw": "{\n    \"username\": \"kasir_citra\",\n    \"email\": \"citra@cafe.com\",\n    \"password\": \"password123\",\n    \"umur\": 22,\n    \"alamat\": \"Bandung\",\n    \"tglLahir\": \"2002-03-10\",\n    \"noTelp\": \"081234567892\",\n    \"role\": \"KARYAWAN\"\n}"
