							"type": "bearer",
							"bearer": [{"key": "token", "value": "{{admin_token}}", "type": "string"}]
						},
						"method": "PUT",
						"header": [
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"kasir_andi_updated\",\n    \"email\": \"andi.updated@cafe.com\",\n    \"umur\": 26,\n    \"alamat\": \"Surabaya\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/karyawan/1",
							"host": ["{{base_url}}"],
							"path": ["api", "karyawan", "1"]
						},
						"description": "Update employee by ID.\nUpdate karyawan berdasarkan ID."
					}
				},
				{
					"name": "Delete Karyawan",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{"key": "token", "value": "{{admin_token}}", "type": "string"}]
						},
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/karyawan/2",
							"host": ["{{base_url}}"],
							"path": ["api", "karyawan", "2"]
						},
						"description": "Delete employee by ID.\nHapus karyawan berdasarkan ID."
					}
				},
				{
					"name": "Bulk Delete Karyawan (max 5)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{"key": "token", "value": "{{admin_token}}", "type": "string"}]
						},
						"method": "DELETE",
						"header": [
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"ids\": [3, 4, 5]\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/karyawan/bulk",
							"host": ["{{base_url}}"],
							"path": ["api", "karyawan", "bulk"]
						},
						"description": "Delete multiple employees at once (max 5).\nHapus beberapa karyawan sekaligus (maks 5)."
					}
				}
			]
		},
		{
