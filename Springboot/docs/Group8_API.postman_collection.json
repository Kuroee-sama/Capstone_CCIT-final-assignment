						},
						"description": "Get transaction by ID.\nAmbil transaksi berdasarkan ID."
					}
				},
				{
					"name": "Get Transaksi by Karyawan ID",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{"key": "token", "value": "{{jwt_token}}", "type": "string"}]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/transaksi/karyawan/1?page=0&size=5",
							"host": ["{{base_url}}"],
							"path": ["api", "transaksi", "karyawan", "1"],
							"query": [
								{"key": "page", "value": "0"},
								{"key": "size", "value": "5"}
							]
						},
						"description": "Get transactions by specific karyawan ID.\nAmbil transaksi berdasarkan ID karyawan tertentu."
					}
				},
				{
					"name": "Get My Transaksi",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{"key": "token", "value": "{{jwt_token}}", "type": "string"}]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/transaksi/my?page=0&size=5",
							"host": ["{{base_url}}"],
							"path": ["api", "transaksi", "my"],
							"query": [
								{"key": "page", "value": "0"},
								{"key": "size", "value": "5"}
							]
						},
						"description": "Get current user's transactions (karyawanId from JWT).\nAmbil transaksi user saat ini (karyawanId dari JWT)."
					}
				},
				{
					"name": "Create Transaksi with Details",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{"key": "token", "value": "{{jwt_token}}", "type": "string"}]
						},
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"}
