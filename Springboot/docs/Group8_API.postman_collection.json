						"auth": {
							"type": "bearer",
							"bearer": [{"key": "token", "value": "{{admin_token}}", "type": "string"}]
						},
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "[\n    {\n        \"username\": \"kasir_deni\",\n        \"email\": \"deni@cafe.com\",\n        \"password\": \"password123\",\n        \"umur\": 24,\n        \"role\": \"KARYAWAN\"\n    },\n    {\n        \"username\": \"kasir_eka\",\n        \"email\": \"eka@cafe.com\",\n        \"password\": \"password123\",\n        \"umur\": 26,\n        \"role\": \"KARYAWAN\"\n    }\n]"
						},
						"url": {
							"raw": "{{base_url}}/api/karyawan/bulk",
							"host": ["{{base_url}}"],
							"path": ["api", "karyawan", "bulk"]
						},
						"description": "Create multiple employees at once (max 5).\nBuat beberapa karyawan sekaligus (maks 5)."
