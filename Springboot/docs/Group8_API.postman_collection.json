		{
			"name": "4. Transaksi - Transaction (KARYAWAN)",
			"description": "Endpoints for managing transactions. KARYAWAN role required.\nEndpoint untuk mengelola transaksi. Membutuhkan role KARYAWAN.",
			"item": [
				{
					"name": "Get All Transaksi (Paginated)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{"key": "token", "value": "{{jwt_token}}", "type": "string"}]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/transaksi?page=0&size=5&sortBy=transaksiId&sortDir=desc",
							"host": ["{{base_url}}"],
							"path": ["api", "transaksi"],
							"query": [
								{"key": "page", "value": "0"},
								{"key": "size", "value": "5"},
								{"key": "sortBy", "value": "transaksiId"},
								{"key": "sortDir", "value": "desc"}
