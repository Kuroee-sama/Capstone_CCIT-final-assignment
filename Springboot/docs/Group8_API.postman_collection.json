							"type": "bearer",
							"bearer": [{"key": "token", "value": "{{admin_token}}", "type": "string"}]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/karyawan?page=0&size=5&sortBy=karyawanId&sortDir=asc",
							"host": ["{{base_url}}"],
							"path": ["api", "karyawan"],
							"query": [
								{"key": "page", "value": "0"},
								{"key": "size", "value": "5"},
								{"key": "sortBy", "value": "karyawanId"},
								{"key": "sortDir", "value": "asc"}
