{
	"info": {
		"_postman_id": "group8-transaction-api",
		"name": "Group-8 Transaction API",
		"description": "Complete API collection for Group-8 Transaction System.\n\nThis collection covers:\n- Authentication (Register, Login)\n- Karyawan Management (ADMIN only)\n- Menu Management (KARYAWAN)\n- Transaction Management (KARYAWAN)\n\n## Setup Instructions\n1. Create environment with variables: base_url, jwt_token, admin_token\n2. Set base_url to http://localhost:8080\n3. Run Register/Login to get tokens\n4. Use tokens in Authorization header",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "jwt_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "admin_token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Auth - Autentikasi",
			"description": "Endpoints for authentication (public, no token required)\nEndpoint untuk autentikasi (publik, tidak perlu token)",
			"item": [
				{
					"name": "Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/auth/health",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "health"]
						},
						"description": "Check if auth service is running.\nCek apakah service autentikasi berjalan."
					}
				},
				{
					"name": "Register KARYAWAN",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set('jwt_token', jsonData.token);",
									"    console.log('Token saved to jwt_token');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"kasir_andi\",\n    \"email\": \"andi@cafe.com\",\n    \"password\": \"password123\",\n    \"umur\": 25,\n    \"alamat\": \"Jl. Sudirman No. 123, Jakarta\",\n    \"tglLahir\": \"1999-05-15\",\n    \"noTelp\": \"081234567890\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/register",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "register"]
						},
						"description": "Register new employee with KARYAWAN role.\nRegistrasi karyawan baru dengan role KARYAWAN.\n\nToken will be automatically saved to jwt_token variable."
					}
				},
				{
					"name": "Register ADMIN",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set('admin_token', jsonData.token);",
									"    console.log('Token saved to admin_token');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"admin_budi\",\n    \"email\": \"budi@cafe.com\",\n    \"password\": \"admin123\",\n    \"umur\": 30,\n    \"alamat\": \"Jl. Gatot Subroto No. 456, Jakarta\",\n    \"tglLahir\": \"1994-08-20\",\n    \"noTelp\": \"081234567891\",\n    \"role\": \"ADMIN\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/register",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "register"]
						},
						"description": "Register new employee with ADMIN role.\nRegistrasi karyawan baru dengan role ADMIN.\n\nToken will be automatically saved to admin_token variable."
					}
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set('jwt_token', jsonData.token);",
									"    console.log('Token saved to jwt_token');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"kasir_andi\",\n    \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "login"]
						},
						"description": "Login with username/email and password.\nLogin dengan username/email dan password.\n\nYou can use email instead of username.\nAnda bisa menggunakan email sebagai pengganti username."
					}
				}
			]
		},
		{
			"name": "2. Karyawan - Employee (ADMIN)",
			"description": "Endpoints for managing employees. ADMIN role required.\nEndpoint untuk mengelola karyawan. Membutuhkan role ADMIN.",
			"item": [
				{
					"name": "Get All Karyawan (Paginated)",
